# Copy to backend/.env and fill in.

# GitHub App (Device Flow) — register one at
# https://github.com/settings/apps/new with:
#   - "Device Flow" enabled under "Identifying and authorizing users"
#   - Repository permissions: Contents (Read and write),
#     Pull requests (Read and write) — Metadata (Read-only) is added
#     automatically
#   - "Where can this GitHub App be installed?" -> Any account
# Then paste its Client ID here. No client secret is needed — that's the
# whole point of the device flow for a downloadable desktop app.
GITHUB_CLIENT_ID=

# Direct link translators are sent to if the App isn't installed on their
# account yet — https://github.com/apps/<your-app-slug>/installations/new
GITHUB_APP_INSTALL_URL=

# Upstream repo this app edits. Defaults match ethos-manual-rework itself;
# only override for testing against a fork.
GITHUB_OWNER=robthomson
GITHUB_REPO=ethos-manual-rework
GITHUB_DEFAULT_BRANCH=main

# Dev only — must match the Vite dev server's origin for session cookies
# to work (see server.ts's CORS setup).
FRONTEND_ORIGIN=http://localhost:5173

# Optional. Auto-generated per run if omitted; fine for a single-user
# desktop install since sessions don't need to survive a restart anyway.
SESSION_SECRET=
